# Groq API key (required) - https://console.groq.com/keys
GROQ_API_KEY=

# Fast/cheap Groq model used ONLY as a last-resort for ambiguous locator ranking
# and for step-parsing fallback when rule-based parsing fails.
GROQ_MODEL=openai/gpt-oss-20b

# Run browser headed (false) so healing is visible, or headless (true) for CI.
HEADLESS=false

BROWSER=chromium

# Confidence thresholds (0-1) driving the 3.6 confidence-decision stage.
CONFIDENCE_AUTO_HEAL=0.95
CONFIDENCE_FLAG=0.80

# Where persisted locator memory / reports go (relative to project root).
CHROMA_DIR=chroma_db
REPORTS_DIR=reports
LOCATOR_HISTORY_FILE=locator_history.json

# Default per-action timeout in ms before self-healing kicks in.
ACTION_TIMEOUT_MS=5000
